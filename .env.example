# Local mode is the runnable demo. Live identity checks are prepared, but live payload and governance APIs remain unavailable.
RESEARCHVAULT_MODE=local-simulation
# To inspect the gated live identity path, set RESEARCHVAULT_MODE=live and supply an IGA-enabled
# realm adapter as CLIENT_ADAPTER or data/tidecloak.json. No realm credentials are included.
CLIENT_ADAPTER=
# On a deployed/proxied live app, set the exact browser-facing origin (for example https://vault.example.org).
# Without this, DPoP accepts only direct loopback Host headers and ignores forwarded-host/proto headers.
TIDE_PUBLIC_ORIGIN=
# Map these to role names in the configured `resource` client; unrelated clients do not grant app roles.
TIDE_ROLE_PARTICIPANT=
TIDE_ROLE_RESEARCH_ASSISTANT=
TIDE_ROLE_HEAD_RESEARCHER=
TIDE_ROLE_DATA_STEWARD=
TIDE_ROLE_ETHICS_REPRESENTATIVE=
