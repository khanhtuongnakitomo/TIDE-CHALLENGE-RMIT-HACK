{
  "name": "researchvault-demo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-full.mjs",
    "dev:backend": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "dev:fe": "pnpm --dir FE dev",
    "build": "next build --webpack",
    "build:fe": "pnpm --dir FE build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit && pnpm --dir FE exec tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:workflow": "node --experimental-strip-types scripts/verify-user-workflow.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/reset-demo.ts",
    "smoke:production-mode": "node scripts/smoke-production-mode.mjs"
  },
  "dependencies": {
    "@tidecloak/js": "0.14.41",
    "@tidecloak/nextjs": "0.14.40",
    "@tidecloak/react": "0.14.33",
    "@tideorg/js": "0.14.29",
    "heimdall-tide": "0.14.41",
    "jose": "5.10.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
